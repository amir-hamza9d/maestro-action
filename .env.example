# Applitools configuration
# Replace with your actual API key
APPLITOOLS_API_KEY=your_api_key_here

# Optional Applitools configuration
# APPLITOOLS_APP_NAME=My Mobile App
# APPLITOOLS_BATCH_NAME=Visual Tests Batch
# APPLITOOLS_MATCH_LEVEL=Strict
# DEBUG=true

# Maestro configuration
# Sets the logback layout for logging in the console
MAESTRO_CLI_LOG_PATTERN_CONSOLE=%highlight([%5level]) %msg%n

# Other Maestro environment variables
# MAESTRO_DRIVER_TIMEOUT=20000
# MAESTRO_CLOUD_API_KEY=your_cloud_api_key_here
